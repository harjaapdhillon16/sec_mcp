# Server
PORT=3000
MCP_HOST=0.0.0.0
MCP_ALLOWED_HOSTS=

# Context security (optional audience override)
CONTEXT_AUDIENCE=

# Database
DATABASE_URL=

# SEC
SEC_USER_AGENT=Your Name your.email@example.com
SEC_MIN_INTERVAL_MS=200

# Embeddings
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_MAX_TOKENS=7000

# Optional LLM summarization
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.2
LLM_MAX_INPUT_TOKENS=6000

# Tavily search (optional)
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=3
TAVILY_TIMEOUT_MS=10000

# Chunking
CHUNK_MAX_WORDS=900
CHUNK_OVERLAP_WORDS=120


TRANSCRIPT_PROVIDER=fmp
FMP_API_KEY=
